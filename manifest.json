{
  "manifest_version": 3,
  "name": "Inaccurate Piano MIDI",
  "version": "1.0.1",
  "description": "Control YouTube video cues and playback from a MIDI piano or pedals.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Inaccurate Piano MIDI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
